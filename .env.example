# Instanter environment template. Copy to .env and fill in. Never commit .env.
# Every variable below is read by the shipped code, except AWS_PROFILE, which
# the AWS SDK and CLI consume ambiently (the code never reads it itself).

AWS_REGION=us-east-1
AWS_PROFILE=your-aws-profile

# CDK / door (reuse the live ORIGIN_SECRET; never mint a new one on a live stack)
# DOOR_ORIGIN_SECRET=
# AGENT_RUNTIME_ARN=
# AGENT_RUNTIME_ROLE_ARN=
# GIT_SHA=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_MAILTO=mailto:stephensookra@gmail.com
# AUDIT_LOCK_BUCKET=   # set on the AgentCore runtime after the lock bucket exists
# PUSH_TABLE=          # set by CDK on the door Lambda
# STATE_BUCKET=        # AgentCore run state
# OTEL_SERVICE_NAME=instanter

# Optional knobs, all with safe defaults (read at synth or in the door Lambda)
# MAX_RUNS_PER_DAY=200             # visitor spend cap, per day
# MAX_SCHEDULED_RUNS_PER_DAY=2     # morning-sweep budget, separate on purpose
# MAX_AWAITING_SCAN=500            # /api/awaiting row-walk bound
# MAX_PUSH_SUBSCRIPTIONS=200       # push table cap
# AUDIT_LOCK_RETAIN_DAYS=30        # Object Lock Compliance retention
# COURT_TZ=America/New_York        # the court's calendar, not UTC
# SEED_PATH=                       # override the corpus location
