# Instanter environment template. Copy to .env and fill in. Never commit .env.
# Every variable listed here is read by the shipped code.

AWS_REGION=us-east-1
AWS_PROFILE=your-aws-profile

# CDK / door (reuse the live ORIGIN_SECRET; never mint a new one on a live stack)
# DOOR_ORIGIN_SECRET=
# AGENT_RUNTIME_ARN=
# AGENT_RUNTIME_ROLE_ARN=
# GIT_SHA=
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_MAILTO=mailto:stephensookra@gmail.com
# AUDIT_LOCK_BUCKET=   # set on the AgentCore runtime after the lock bucket exists
# PUSH_TABLE=          # set by CDK on the door Lambda
# STATE_BUCKET=        # AgentCore run state
# OTEL_SERVICE_NAME=instanter
