{
  "expo": {
    "name": "Instanter",
    "slug": "instanter",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stephensookra.instanter",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.developer.usernotifications.live-activities": true
      },
      "appleTeamId": "Y8XVCMLQCZ"
    },
    "android": {
      "package": "com.stephensookra.instanter",
      "adaptiveIcon": {
        "backgroundColor": "#faf6f0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "instanter",
    "backgroundColor": "#141414",
    "primaryColor": "#c2352b",
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.2"
          }
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withInstanterLiveActivity.js"
    ],
    "extra": {
      "doorUrl": "https://d2ew2t4uldglcr.cloudfront.net",
      "eas": {
        "projectId": "f6e678f9-6942-4797-8c5a-c46db300dbf2"
      }
    },
    "owner": "stephensook"
  }
}
